PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Supabase (PostgreSQL + Auth)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
# Optional (legacy HS256 projects)
SUPABASE_JWT_SECRET=

# Stripe (price is server-side only — never accept priceId from the client)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID=

# PayPal
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox

# AI providers (use at least one)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
DEFAULT_AI_PROVIDER=openai

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Lunyon <noreply@lunyon.app>

# Google Workspace (backend only — never VITE_*)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/api/integrations/google/callback
# 32-byte key as 64 hex characters (AES-256-GCM)
INTEGRATION_ENCRYPTION_KEY=
